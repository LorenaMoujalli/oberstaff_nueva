import GuiaContratacion from "../../../components/guia-contratacion-perfiles/GuiaContratacion.astro";

const ogImage = "Contratar-closer-de-ventas.webp";

const faqsList = [
    {
        question: "Will my remote sales closer work with other company accounts at the same time?",
        answers: ["No. The closer is assigned exclusively to your company under the schedule defined in the proposal and does not divide the agreed working hours among other client accounts."]
    },
    {
        question: "Can LATAM sales closers sell to U.S. prospects in fluent English?",
        answers: ["Yes, when professional English is part of the role requirements. Candidates selected for U.S.-based positions are evaluated for the required written and verbal level, typically from B2 to C2, as well as clarity, listening, commercial communication, and buyer-facing confidence."]
    },
    {
        question: "What is the difference between a Sales Closer and an SDR or Setter?",
        answers: [
            "The roles can work in the same funnel, but their ownership is different:",
            "<strong>SDR / Setter - Prospecting and Qualification Owner:</strong> Generates or contacts prospects, qualifies fit and interest, and books the next sales step according to the company's process.",
            "<strong>Sales Closer - Late-Stage Conversion Owner:</strong> Takes over qualified opportunities, runs the decision-stage conversation, handles objections, follows up on proposals, negotiates within approved boundaries, and drives the opportunity toward a clear outcome.",
        ]
    },
    {
        question: "What is the difference between a freelance sales closer and Oberstaff?",
        answers: ["A freelance closer may be useful for a short campaign, but availability, process integration, and continuity can vary. <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> provides dedicated full-time talent, role-specific vetting, international staffing support, and an operating model designed for ongoing integration with your CRM and sales team."]
    },
    {
        question: "Which CRM and sales tools can the professional use?",
        answers: ["Depending on experience and scope, candidates may work with HubSpot, Salesforce, Pipedrive, Zoho CRM, Gong, Salesloft, Outreach, Aircall, Dialpad, Calendly, Zoom, Google Meet, Slack, Microsoft Teams, Notion, and other approved sales or collaboration tools."]
    },
    {
        question: "Which sales KPIs should we use to measure the closer?",
        answers: ["The right scorecard depends on your funnel and sales cycle. Common measures include close rate, show rate, stage conversion, sales-cycle length, follow-up completion, average deal value, win rate by lead source, forecast accuracy, and documented loss reasons."]
    },
    {
        question: "How are sales closer candidates evaluated?",
        answers: ["Candidates undergo experience screening, communication assessment, sales roleplays or realistic scenarios, objection-handling evaluation, CRM or tool validation, English or bilingual assessment when required, reference or performance-evidence review when available, and interviews focused on your sales motion."]
    },
    {
        question: "What happens if the sales closer does not adapt to our sales process or performance expectations?",
        answers: ["If the profile is not aligned with the agreed role, process, or KPIs during onboarding, <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> can review the fit and support recalibration. If the mismatch remains, you can request a replacement candidate or cancel according to the notice terms defined in your service agreement, without directly employing the professional."]
    },
    {
        question: "Which countries do sales closer candidates come from?",
        answers: ["<span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> recruits sales professionals across Latin America, including markets such as Colombia, Argentina, Peru, Venezuela, and Mexico, subject to availability, language requirements, schedule, seniority, sales specialization, and the selected service model."]
    },
    {
        question: "How does billing and payroll work for U.S. companies?",
        answers: ["You receive a consolidated monthly invoice in U.S. dollars from <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> coordinates the international contracting and payroll administration for the professional under the agreed service model."]
    }
];
