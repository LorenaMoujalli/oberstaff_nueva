import GuiaContratacion from "../../../components/guia-contratacion-perfiles/GuiaContratacion.astro";

const ogImage = "Contratar-Contable.webp";

const faqsList = [
    {
        question: "Can I Hire Virtual Bookkeeper Talent Dedicated to My Company?",
        answers: [
            "The assigned schedule and level of dedication are defined in your proposal. When the role is contracted as dedicated talent, the agreed working hours are allocated to your company rather than divided among unrelated client work.",
        ],
    },
    {
        question: "Can LATAM bookkeepers work with U.S. teams in professional English?",
        answers: [
            "Yes. Candidates for U.S.-based roles are screened for the English level required by the position, including written communication, finance terminology, vendor or customer interaction when applicable, and collaboration with managers, controllers, or CPAs.",
        ],
    },
    {
        question: "What is the difference between a Bookkeeper and an Accountant or CPA?",
        answers: [
            "The roles can collaborate closely, but their core ownership is different:",
            "<strong>Accountant / CPA - Professional Accounting, Tax, and Financial Judgment:</strong> Depending on credentials and engagement, may handle complex accounting analysis, tax work, assurance, financial reporting decisions, advisory services, and other professional responsibilities.",
            "<strong>Bookkeeper - Daily Financial Record Owner:</strong> Maintains routine transaction records, reconciliations, AP/AR, supporting documents, bookkeeping schedules, and recurring reports so the underlying books remain organized and ready for review.",
        ],
    },
    {
        question: "What is the difference between a freelance bookkeeper and Oberstaff?",
        answers: [
            "A freelance bookkeeper is contracted and managed directly by your company, and availability may depend on the contractor's other clients. Oberstaff provides a structured sourcing, role-specific screening, talent-administration, billing, service-support, and replacement process according to the agreed engagement.",
        ],
    },
    {
        question: "Can I Hire QuickBooks Bookkeeper Talent Through Oberstaff.?",
        answers: [
            "Yes. Depending on experience and scope, candidates may work as a QuickBooks remote bookkeeper or use Xero, Odoo, SAP Business One, Zoho Books, Excel, Google Sheets, cloud document systems, and other approved bookkeeping or reporting tools used by your company.",
        ],
    },
    {
        question: "How often should reconciliations and bookkeeping records be updated?",
        answers: [
            "The right cadence depends on transaction volume, cash-flow sensitivity, reporting deadlines, payment activity, and month-end requirements. Your company should define which accounts require daily, weekly, or monthly attention and the deadline for resolving exceptions.",
        ],
    },
    {
        question: "How are candidates evaluated?",
        answers: [
            "Candidates undergo experience screening, bookkeeping and reconciliation exercises, AP/AR scenarios, accounting-software validation, English assessment when required, work-sample or reference review when available, and interviews focused on realistic bookkeeping situations.",
        ],
    },
    {
        question: "What happens if the professional does not adapt to our bookkeeping process or quality standards?",
        answers: [
            "If the selected bookkeeper is not meeting the agreed process, documentation, communication, or quality requirements during onboarding, Oberstaff. can support recalibration and performance follow-up. If the fit still is not right, the replacement or cancellation options are handled according to the terms of the service agreement.",
        ],
    },
    {
        question: "Which countries do candidates come from?",
        answers: [
            "Oberstaff. recruits finance and bookkeeping professionals across Latin America, including Colombia, Argentina, Peru, Venezuela, Chile, and Mexico. U.S. companies that want to hire a nearshore bookkeeping team in Latin America can build coverage around language requirements, schedule, specialization, and the selected service model, subject to candidate availability.",
        ],
    },
    {
        question: "How does billing and talent administration work for U.S. companies?",
        answers: [
            "You receive a consolidated monthly invoice in U.S. dollars from Oberstaff. The applicable international contracting, professional compensation, and talent administration are coordinated under the service model defined for the engagement.",
        ],
    },
];
