const ogImage = "Experto-en-Meta-Ads.webp";

const faqsList = [
    {
        question: "Will my remote Facebook Ads expert work with other company accounts at the same time?",
        answers: ["No. The Facebook Ads expert is assigned exclusively to your company under the schedule defined in the proposal and does not divide the agreed working hours among other client accounts."]
    },
    {
        question: "Can a LATAM Facebook Advertising Specialist manage U.S. campaigns in fluent English?",
        answers: ["Yes. Candidates selected for U.S.-based roles are screened for the professional written and verbal English level required by the position. Bilingual EN/ES capability can also be included when your campaigns target Spanish-speaking audiences."]
    },
    {
        question: "What is the difference between a Meta Ads Expert and a Social Media Manager?",
        answers: [
            "Both roles may collaborate, but their ownership is different:",
            "<strong>Social Media Manager - Organic Channel Owner:</strong> Defines organic channel strategy, content pillars, editorial calendars, publishing, community growth, brand presence, and organic analytics.",
            "<strong>Meta Ads Expert - Paid Acquisition Owner:</strong> Manages Facebook and Instagram advertising structure, audiences, budget allocation, tracking, creative testing, optimization, attribution, and paid-media reporting tied to acquisition outcomes.",
        ]
    },
    {
        question: "What is the difference between a Facebook Ads freelancer and Oberstaff?",
        answers: ["A freelancer may be a good fit for audits, short projects, or flexible support, but availability and continuity can vary across clients. Oberstaff provides a dedicated professional, role-specific vetting, international staffing support, monthly billing, and profile replacement options according to the service terms."]
    },
    {
        question: "Which platforms and tools can the professional manage?",
        answers: ["Depending on experience and scope, candidates may work with Meta Business Manager, Ads Manager, Events Manager, Meta Pixel, Conversions API, product catalogs, Advantage+ campaigns, GTM, GA4, Looker Studio, Shopify, WooCommerce, HubSpot, Salesforce, call-tracking tools, landing-page platforms, and other approved analytics or CRM systems."]
    },
    {
        question: "What access does the Meta Ads expert need, and how often should campaigns be optimized?",
        answers: ["The specialist typically needs role-based access to the Business Manager, ad account, Pixel or datasets, catalogs, and relevant measurement or revenue systems. Optimization cadence depends on spend, conversion volume, learning status, creative fatigue, campaign objective, and business feedback; high-frequency changes are not automatically better."]
    },
    {
        question: "How are candidates evaluated?",
        answers: ["Candidates undergo experience screening, account-diagnosis exercises, campaign-structure scenarios, performance-metric interpretation, creative-testing evaluation, tracking and attribution questions, English or bilingual assessment, work-sample review when available, and interviews focused on realistic Meta Ads situations."]
    },
    {
        question: "What happens if the professional does not adapt to our account, team, or performance standards?",
        answers: ["During onboarding, your team and Oberstaff can recalibrate expectations, reporting, communication, account priorities, and operating routines. If the fit still is not right, you can request a profile review or replacement according to the conditions of the service."]
    },
    {
        question: "Which countries do candidates come from?",
        answers: ["Oberstaff. recruits paid media and Meta Ads professionals across Latin America, including Colombia, Argentina, Peru, Venezuela, and Mexico, subject to availability, language requirements, seniority, schedule, and the selected service model."]
    },
    {
        question: "How do billing, payroll, and Meta advertising spend work for U.S. companies?",
        answers: ["You receive a monthly invoice in U.S. dollars from Oberstaff. for the agreed talent service. Oberstaff. manages the international contracting and payroll administration for the professional. Your company keeps control of its Meta ad account and pays advertising spend directly to Meta through its own payment method."]
    },
];
