const faqsList = [
    {
        question: "Will my remote virtual assistant work with other company accounts at the same time?",
        answers: ["No. Under the dedicated model described on this page, the virtual assistant is assigned exclusively to your company under the schedule and scope defined in the proposal and does not divide those agreed working hours among other client accounts."]
    },
    {
        question: "Can LATAM virtual assistants work with U.S. teams in fluent English?",
        answers: ["Yes. English proficiency is evaluated according to the requirements of the role. Candidates presented for U.S.-facing positions are screened for the written and verbal communication level required for the assigned responsibilities, with bilingual EN/ES options available when needed."]
    },
    {
        question: "What is the difference between a Virtual Assistant and an Executive Assistant?",
        answers: ["Both roles can provide remote administrative support, but their typical scope and stakeholders are different:", "<strong>Virtual Assistant - Operational Support:</strong> Can manage calendars, inboxes, CRM updates, documents, reporting, customer or vendor follow-up, eCommerce administration, and other recurring back-office tasks across a team.","<strong>Executive Assistant - Leadership Support:</strong> Usually works more closely with founders or senior leaders on complex scheduling, priority communications, meeting preparation, travel, confidential coordination, and executive-level follow-up."]
    },
    {
        question: "What is the difference between a freelance virtual assistant and <span style='color:#1b1b1b; font-weight:800;'>Oberstaff<span style='color: #FF66CC; font-weight:800;''>.</span></span>?",
        answers: ["A freelancer may be ideal for limited or project-based support, but availability, screening, continuity, and administration depend on the individual engagement. Oberstaff. provides a dedicated talent model with role-specific screening, a structured shortlist, international service administration, ongoing support, and replacement options subject to the service agreement."]
    },
    {
        question: "Which tools can the professional manage?",
        answers: ["Depending on experience and scope, candidates may work with Google Workspace, Microsoft 365, Slack, Microsoft Teams, Zoom, Calendly, Notion, Asana, ClickUp, Trello, Monday.com, HubSpot, Salesforce, Zendesk, Intercom, Gorgias, Shopify, spreadsheets, CRMs, databases, and other approved business systems."]
    },
    {
        question: "How quickly should administrative tasks and requests be completed?",
        answers: ["The right SLA depends on task type, business impact, system access, workload, dependencies, and the agreed working hours. Your company should define priorities for urgent requests, same-day follow-up, recurring daily tasks, weekly reporting, and work that requires approval from another team member."]
    },
    {
        question: "How are candidates evaluated?",
        answers: ["Candidates may undergo experience screening, English or bilingual assessment, administrative exercises, communication tests, tool validation, spreadsheet or CRM tasks, prioritization scenarios, remote-work readiness review, reference or work-sample checks when available, and interviews based on realistic operating situations."]
    }
    ,{
        question: "What happens if the professional does not adapt to our processes or quality standards?",
        answers: ["<span style='color:#1b1b1b; font-weight:800;'>Oberstaff<span style='color: #FF66CC; font-weight:800;''>.</span></span> can help recalibrate onboarding, clarify SOPs, access, task priorities, and performance expectations. If the fit still is not right, replacement options can be requested according to the service agreement. Cancellation and notice terms are also governed by the applicable contract."]
    },
    {
        question: "Which countries do candidates come from?",
        answers: ["<span style='color:#1b1b1b; font-weight:800;'>Oberstaff<span style='color: #FF66CC; font-weight:800;''>.</span></span> recruits remote professionals across Latin America, including markets such as Colombia, Argentina, Peru, Venezuela, and Mexico, subject to availability, role requirements, language level, schedule, and the selected service model."]
    },{
        question: "How does billing and payroll administration work for U.S. companies?",
        answers: ["Your company receives a consolidated monthly invoice in U.S. dollars from <span style='color:#1b1b1b; font-weight:800;'>Oberstaff<span style='color: #FF66CC; font-weight:800;''>.</span></span> We coordinate the agreed international contracting structure, professional compensation or payroll administration, and service documentation according to the engagement model."]
    }
];
