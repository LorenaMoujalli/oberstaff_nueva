import GuiaContratacion from "../../../components/guia-contratacion-perfiles/GuiaContratacion.astro";

const ogImage = "Contratar-Copywriter.webp";

const faqsList = [
    {
        question: "Will my remote copywriter work with other company accounts at the same time?",
        answers: [
            "No. The copywriter is assigned to your company under the schedule and scope defined in the proposal and does not divide the agreed working hours among other client accounts.",
        ],
    },
    {
        question: "Can LATAM professionals write fluent U.S. English?",
        answers: [
            "Yes. Candidates selected for U.S.-based copywriting roles are evaluated for professional English, written clarity, tone, editing quality, and the ability to adapt messaging to a U.S. business audience. Bilingual EN/ES capability can also be included when the role requires it.",
        ],
    },
    {
        question: "What is the difference between a copywriter and a content or SEO writer?",
        answers: [
            "Both roles can collaborate, but their primary objectives are different:",
            "<strong>Content or SEO Writer - Information and Organic Visibility:</strong> Creates educational, editorial, or search-focused content designed to answer questions, build topical authority, and attract organic demand.",
            "<strong>Copywriter - Commercial Action and Conversion:</strong> Writes value propositions, landing pages, ads, email, product copy, CTAs, and sales assets designed to reduce objections and move the buyer toward a defined action.",
        ],
    },
    {
        question: "What is the difference between a freelance copywriter and Oberstaff?",
        answers: [
            "A freelance copywriter can be effective for isolated projects, but availability, continuity, and accumulated business context may vary across engagements. Oberstaff. provides a dedicated professional under the agreed schedule, role-specific screening, international administration, and ongoing service support.",
        ],
    },
    {
        question: "Which assets and channels can the professional support?",
        answers: [
            "Depending on experience and scope, candidates may work on homepages, service pages, landing pages, Meta Ads, Google Ads, lifecycle email, CRM sequences, product and category pages, checkout microcopy, sales scripts, one-pagers, proposals, presentations, VSL concepts, and other approved commercial assets.",
        ],
    },
    {
        question: "How should copywriting performance be measured?",
        answers: [
            "The right KPI depends on the asset and funnel stage. Common signals include page conversion rate, qualified lead rate, CTA interaction, CTR, CPL, CPA, replies, clicks, booked meetings, purchases, and test-level lift. Copy should be evaluated together with traffic quality, offer strength, design, media, and sales execution.",
        ],
    },
    {
        question: "How are candidates evaluated?",
        answers: [
            "Candidates undergo experience screening, writing and editing exercises, buyer-research and message-structure evaluation, brand-voice adaptation, English or bilingual assessment, work-sample review, and interviews focused on realistic copywriting scenarios.",
        ],
    },
    {
        question: "What happens if the professional does not adapt to our brand voice or quality standards?",
        answers: [
            "Brand-voice fit is critical. If the first deliverables are not aligned, the brief, examples, review criteria, and feedback process can be recalibrated during onboarding. If the fit still is not right, you can request a replacement or use the cancellation terms defined in your service agreement.",
        ],
    },
    {
        question: "Which countries do candidates come from?",
        answers: [
            "Oberstaff. recruits professionals across Latin America, including Colombia, Argentina, Peru, Venezuela, and Mexico, subject to availability, language requirements, schedule, specialization, and the selected service model.",
        ],
    },
    {
        question: "How does billing and payroll work for U.S. companies?",
        answers: [
            "You receive a consolidated monthly invoice in U.S. dollars from Oberstaff. International contracting, professional compensation, payroll administration, and related service processes are managed according to the agreed engagement structure.",
        ],
    },
];
