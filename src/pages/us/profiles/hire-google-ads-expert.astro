const ogImage = "Especialista-en-Google-Ads.webp"; 

const faqsList = [
    {
        question: "Will my remote Google Ads specialist work with other company accounts at the same time?",
        answers: ["No. The specialist is assigned to your company under the schedule and scope defined in the proposal and does not divide the agreed working hours among other client accounts."]
    },
    {
        question: "Can LATAM Google Ads professionals work in fluent English with a U.S. marketing team?",
        answers: ["Yes. Candidates selected for U.S.-based roles are evaluated for professional written and verbal English according to the position, with the level aligned to stakeholder communication, reporting, meetings, and account-management requirements."]
    },
    {
        question: "What is the difference between a Google PPC expert and a broader Paid Media Manager?",
        answers: ["An expert Google Ads professional focuses primarily on the Google advertising ecosystem, including Search, Performance Max, Shopping, Display, YouTube, bidding, search terms, conversion tracking, and account optimization.", "<strong>Paid Media Manager - Channel Portfolio Owner:</strong> May manage strategy and budget across Google, Meta, LinkedIn, TikTok, programmatic, or other paid channels. The exact distinction depends on the company's team structure and scope."]
    },
    {
        question: "What is the difference between a Google Ads freelancer and <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span>?",
        answers: ["A freelancer can be effective for audits, setup projects, or fractional support. <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span>'s model is designed around dedicated remote talent, role-specific vetting, international staffing administration, structured onboarding, ongoing service support, and replacement options according to the service terms."]
    },
    {
        question: "Which Google Ads campaign types and tools can the professional manage?",
        answers: ["Depending on experience and scope, candidates may work with Search, Performance Max, Shopping, Merchant Center, Display, YouTube, Demand Gen, remarketing, GA4, Google Tag Manager, Looker Studio, enhanced conversions, call tracking, CRM integrations, and offline conversion workflows. A Google AdWords specialist is the legacy-search equivalent of today's Google Ads role because Google rebranded AdWords as Google Ads. If your team still uses older search language such as hire AdWords expert, hire Google AdWords expert, or hire remote SEM specialist, <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> can screen candidates against the same modern paid-search, tracking, and performance requirements."]
    },
    {
        question: "How quickly should I expect CPA or ROAS to improve?",
        answers: ["There is no responsible fixed timeline because results depend on historical data, conversion volume, budget, competition, tracking quality, landing pages, offer strength, seasonality, sales follow-up, and the size of the changes required. The specialist should establish a diagnostic baseline, prioritize measurement issues, document tests, and evaluate performance over statistically meaningful periods."]
    },
    {
        question: "How are Google Ads specialist candidates evaluated?",
        answers: ["Candidates are screened for relevant account experience, campaign structure, search-term analysis, negative keyword strategy, bidding and budget decisions, Performance Max or Shopping scenarios when relevant, conversion tracking, GA4/GTM knowledge, English communication, and interviews based on realistic account situations."]
    },
    {
        question: "What happens if the professional does not adapt to our account, team, or performance expectations?",
        answers: ["If onboarding reveals a mismatch, the first step is to clarify scope, access, priorities, reporting, and performance expectations. If the fit still is not right, you can request a replacement profile or cancel according to the agreed service terms, including the applicable notice period."]
    },
    {
        question: "Which countries do candidates come from?",
        answers: ["<span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> recruits professionals across Latin America, including Colombia, Argentina, Peru, Venezuela, and Mexico, subject to availability, technical specialization, English requirements, schedule, and the selected service model."]
    },
    {
        question: "How does billing and payroll work for U.S. companies?",
        answers: ["Your company receives a monthly invoice in U.S. dollars from <span style='color: #1b1b1b; font-weight: 800;'> Oberstaff<span style='color: #ff66cc'>.</span></span> Oberstaff coordinates the agreed international contracting and professional-payment administration under the service model. Your Google Ads media spend remains separate and is paid directly by your company through its own Google Ads billing account."]
    },
];
