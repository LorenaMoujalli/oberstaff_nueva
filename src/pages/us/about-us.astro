const ogImage = "quienes-somos-pr.webp";

const faqs = [
  {
    question:
      "What is <strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span>?",
    answers: [
      "<strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span> is an integrated workforce partner that connects corporations and growing businesses in the United States with vetted professionals in South America through structured remote work models built for long-term collaboration.",
    ],
  },
  {
    question:
      "What are the benefits of <strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span> for a U.S. company?",
    answers: [
      "For U.S. companies, <strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span> can expand access to qualified talent, improve operating cost efficiency, reduce the administrative burden of recruiting, and make it easier to add professionals who can collaborate during overlapping U.S. business hours.",
    ],
  },
  {
    question: "How are payments and billing handled?",
    answers: [
      "We simplify monthly administration by consolidating the service into a clear commercial invoice in U.S. dollars (USD). This helps reduce the operational complexity of managing recurring cross-border payments and vendor administration across multiple markets.",
    ],
  },
  {
    question:
      "What makes <strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span> different from a traditional employment agency?",
    answers: [
      "We do not simply forward resumes. We use structured screening criteria to identify candidates with the experience, communication skills, and fit required by the role. Depending on the engagement model, <strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff</strong><span style='color: #ff66cc; font-weight: 800;'>.</span> can also support onboarding, documentation, ongoing administration, and compliance-related coordination.",
    ],
  },
];
