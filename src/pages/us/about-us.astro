    rel="canonical"
    href="https://oberstaff.com/us/about-us/"
    slot="head"
  />
  <link
    rel="alternate"
    hreflang="es-PR"
    href="https://oberstaff.com/pr/quienes-somos/"
    slot="head"
  />
