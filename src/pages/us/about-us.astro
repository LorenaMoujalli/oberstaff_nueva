    cardSubtitle="Complete the form to speak with our team about your hiring needs, team structure, and the most efficient way to add remote professionals to your operation"
    buttonText="Schedule a free consultation →"
    buttonIcon=""
    buttonSubtext=""
    footerLinkText=""
    footerLinkHref="#"
    badges={[
      { text: "More efficient operating costs", icon: "⚡" },
      { text: "Rigorous talent screening", icon: "🔍" },
      { text: "Flexible team scaling", icon: "📈" },
    ]}
    badgesClass="community-badges"
    cardTitleTag="p"
    webhookUrl=""
    formName="About Us US"
    pais="United States"
  >
    <Fragment slot="description">
      We were built to make international remote work more structured, transparent, and sustainable. At <strong
        >Oberstaff<span style="color: #FF66CC;">.</span></strong
      >, we help U.S. companies and qualified professionals across South America collaborate through clear processes, aligned expectations, and shared business goals.
    </Fragment>
  </LeadHeroSection>

  <div class="fade-in-section">
    <div class="fade-in-section quienesomos-que-es">
      <QueEsServicioSection
        title="We are more than a way to control costs. We help U.S. companies scale with structure."
        highlightWord="Somos tu aliado más inteligente para escalar."
        description=""
        imageSrc="/img-quienes.webp"
        imageAlt="Talento profesional en Oberstaff"
        badgeText=" Strategic access to bilingual talent"
        itemTitleTag="h3"
        quoteText="<h3 style='color: #ff66cc; font-size: 15px; font-weight: 800; display: block; margin-bottom: 5px; font-family: inherit;'>What is <span style='color: #1B1B1B;'>Oberstaff</span><span style='color: #ff66cc;'>.</span>?</h3> Oberstaff is a strategic workforce partner that connects U.S. companies with highly qualified professionals in South America through structured remote work models designed for efficient, long-term collaboration."
        infoItems={[
          {
            icon: "",
            title:
              "Why was <span style='color: #1B1B1B; font-weight: 700;'>Oberstaff</span><span style='color: #ff66cc; font-weight: 900;'>.</span> created?",
            description:
              "<strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff<span style='color: #ff66cc; font-weight: 800;'>.</span></strong> was created around a recurring business challenge: companies need specialized talent and additional operating capacity without adding unnecessary complexity to traditional hiring. At the same time, South America offers experienced professionals who can collaborate in overlapping U.S. time zones and contribute as integrated members of remote teams.",
          },
          {
            icon: "",
            title: "Who We Are",
            description:
              "<strong style='color: #1B1B1B; font-weight: 800;'>Oberstaff<span style='color: #ff66cc; font-weight: 800;'>.</span></strong> was founded in 2017 by Edgardo Vázquez with a clear vision: remote work can be much more than a way to lower costs. When it is built around the right people, processes, and expectations, it becomes a flexible way to strengthen teams, expand capabilities, and support sustainable business growth.",
          },
        ]}
        ctaText=""
        ctaHref="#"
      />
    </div>
  </div>

  <div class="fade-in-section">
    <VisionMisionSection
      title="The purpose behind our operating model"
    >
      <VisionMisionCard
        icon="🎯"
        iconBgClass="bg-soft-pink"
        title="Our mission"
        customClass="card-mision"
      >
   Our mission is to make remote collaboration between U.S. companies and professionals in South America work with clarity, trust, accountability, and a strong human focus. We want businesses to expand beyond the limitations of purely local hiring while giving qualified professionals the structure and continuity they need to contribute meaningful results.
      </VisionMisionCard>

      <VisionMisionCard
        icon="👁️"
        iconBgClass="bg-soft-purple"
        title="Our vision"
        customClass="card-vision"
      >
        We envision a business environment where geography does not limit access to the right capabilities. Remote work requires more than connectivity: it needs defined processes, responsible communication, appropriate compliance frameworks, and ongoing support. <strong>Oberstaff<span style="color: #FF66CC;">.</span></strong> exists to help create that infrastructure of trust between U.S. companies and distributed professionals.
      </VisionMisionCard>
    </VisionMisionSection>
  </div>





  <div class="fade-in-section faq-quienesomos-wrapper">
    <FAQSection
      title="Frequently asked questions about <br> <span style='color: #6663FD; font-weight: 900;'>Oberstaff<span style='color: #ff66cc; font-weight: 900;'>.</span></span><span style='color: #ff66cc; font-weight: 900;'></span> in the United States"
      ctaText="Below are common questions about how Oberstaff connects U.S. companies with vetted professionals in South America through structured remote work arrangements and ongoing operational support."
      ctaButtonText="Talk to an advisor →"
      faqs={faqs}
    />
  </div>
</DashboardLayoutContactUs>

