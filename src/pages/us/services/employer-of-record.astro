const ogImage = "employer-of-record-pr.webp"; 

const faqsList = [
	{
		question: "What exactly does an Employer of Record do?",
		answers: ["An Employer of Record legally employs the professional in the country where the person works and administers the local contract, payroll, required benefits, documentation, and recurring employment obligations. Your company continues to manage day-to-day responsibilities, goals, and performance."]
	},
	{
		question: "Is Oberstaff an employer of record USA option for U.S. companies?",
		answers: ["Yes. Oberstaff operates as a specialized Employer of Record (EOR) solution for U.S.-based companies (LLCs, C-Corps) looking to hire and build remote teams in LATAM. We bridge the gap between U.S. corporate compliance and local Latin American employment laws, providing you with a single U.S. dollar invoice while managing all foreign payroll, statutory benefits, and legal employer obligations overseas."]
	},
	{
		question: "What should companies look for in an Employer of Record United States partner?",
		answers: ["When evaluating an Employer of Record United States partner for international hiring, companies should review country coverage, local employment infrastructure, payroll controls, cost transparency, employee support, onboarding timelines, and offboarding procedures. The provider should also clearly explain which responsibilities remain with the U.S. company and which are handled locally by the EOR."]
	},
	{
		question: "When should I use EOR services instead of hiring independent contractors?",
		answers: ["Use EOR when the role demands exclusive dedication, structured hours, and an ongoing working relationship. Classifying permanent team members as independent contractors (W-8BEN / 1099) exposes your US business to IRS misclassification penalties."]
	},
	{
		question: "Does my US business need to register a foreign entity in Latin America?",
		answers: ["No. By leveraging Oberstaff's US EOR service, we use our local entities to employ talent directly, eliminating the need for you to open subsidiaries across LATAM."]
	},
	{
		question: "Can I hire professionals across multiple Latin American countries  simultaneously?",
		answers: ["Yes. You can recruit team members across different countries and centralize all management and payroll with Oberstaff, maintaining streamlined operations for your US company."]
	},
	{
		question: "How long does it take to onboard a new team member with EOR?",
		answers: ["Onboarding typically takes just a few business days, compared to the 3–6 months required to register a foreign subsidiary on your own."]
	},
	{
		question: "How should I compare EOR service providers?",
		answers: ["Compare EOR service providers by country coverage, legal employment structure, cost transparency, payroll controls, onboarding timelines, employee support, offboarding processes, data handling, and account responsiveness."]
	}
];
