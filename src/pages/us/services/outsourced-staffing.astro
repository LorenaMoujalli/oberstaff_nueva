const ogImage = "outsourcing-personal-pr.webp";

const faqsList = [
    {
        question:
            "What exactly do outsourced staffing services include?",
        answers: [
          "<span style='font-weight: 800; color: #1b1b1b;'>Oberstaff’s</span> outsourced staffing services can include role definition, targeted sourcing, candidate screening, shortlist presentation, interview coordination, onboarding support, engagement administration, centralized billing, and ongoing staffing support. Outsourced staff work inside your company’s priorities, tools, and operating procedures, while your managers remain responsible for daily performance."
        ],
    },
    {
        question: "What types of roles does this service cover?",
        answers: [
            "It covers sales, administration, marketing, customer support, back office, finance, creative production, operations, and related business roles. Software, QA, DevOps, and data roles are handled through Staff Augmentation.",
        ],
    },
    {
        question: "Is Oberstaff an outsourced staffing provider for U.S. companies?",
        answers: [
            "Yes. Oberstaff supports U.S.-based companies that want to add dedicated professionals across Latin America. We coordinate recruiting and recurring staffing administration while your company manages the work and receives a consolidated invoice in U.S. dollars.",
        ],
    },
    {
        question: "What does remote staff outsourcing mean in this service?",
        answers: [
            "Remote staff outsourcing means adding professionals who work remotely inside your business processes while an external partner supports the staffing and administrative lifecycle. The responsibilities, schedule, reporting line, and service model are defined before onboarding.",
        ],
    },
    {
        question:
            "What should companies look for in a staffing outsourcing services partner?",
        answers: [
            "When comparing outsourcing talent solutions, companies should review role-specific recruiting capability, country coverage, candidate screening standards, pricing transparency, onboarding processes, responsibility allocation, replacement terms, billing controls, data handling, and account responsiveness.",
        ],
    },
    {
        question:
            "Can I build teams across multiple Latin American countries simultaneously?",
        answers: [
            "Yes. You can source professionals from different supported countries and centralize the staffing relationship with Oberstaff. The recommended market depends on the role, schedule, language level, experience, and budget.",
        ],
    },
    {
        question:
            "How long does it take to onboard a new team member?",
        answers: [
            "Timing varies by role complexity, seniority, language requirements, compensation, candidate availability, and the selected engagement model.  <span style='font-weight: 800; color: #1b1b1b;'>Oberstaff</span> provides a realistic search and onboarding timeline after the role is calibrated.",
        ],
    },
    {
        question: "How should I compare outsourced staffing solutions?",
        answers: [
            "Compare outsourced staffing solutions by candidate quality, role specialization, country coverage, cost visibility, onboarding controls, monthly administration, responsibility split, replacement process, account support, and how well the provider distinguishes staffing from EOR, contractor, and technical staff augmentation models.",
        ],
    }
];
