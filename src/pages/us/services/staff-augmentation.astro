import ContactFormSection from "../../../components/form/ContactFormSection.astro";
//import ArticulosSection from "../../../components/articulos-servicios/ArticulosSection.astro";
import QueEsServicioSection from "../../../components/QueEsServicio/QueEsServicioSection.astro";
import ServicesSection from "../../../components/services-oberstaff/ServicesSection.astro";
import ProcessOberstaff from "../../../components/process/ProcessOberstaff.astro";
import ProfilesSection from "../../../components/profiles/ProfilesSection.astro";
const ogImage = "staff-pr.webp";

const faqsList = [
    {
        question:
            "What do <strong>IT staff augmentation services</strong> include",
        answers: [
            "The service can include technical role calibration, targeted sourcing, candidate screening, shortlist presentation, interview coordination, onboarding support, centralized billing, ongoing staffing support, and replacement coordination under the agreed terms. Your company remains responsible for daily technical direction and performance.",
        ],
    },
    {
        question: "What types of roles does this service cover?",
        answers: [
            "The service covers software engineering, QA and testing, data and analytics, DevOps, cloud infrastructure, UX/UI, product design, technical writing, Scrum, and related technology delivery roles. Non-technical business functions are handled through Outsourced Staffing.",
        ],
    },
    {
        question: "How do time zones work for US teams?",
        answers: [
            "Engineers operate in overlapping time zones matching US Eastern (EST), Central (CST), and Pacific (PST) working hours for real-time collaboration.",
        ],
    },
    {
        question:
            "What does <strong>technical staff augmentation</strong> mean?",
        answers: [
            "It means adding professionals who work directly inside your engineering and product processes while an external partner supports sourcing, screening, onboarding, administration, billing, and continuity. The professional is not a separate outsourced development agency; your company assigns priorities and directs the work.",
        ],
    },
    {
        question:
            "How is this different from project outsourcing?",
        answers: [
            "With project outsourcing, a vendor is usually responsible for delivering a defined scope or outcome. In this model, the professional joins your existing team and works under your technical leadership, using your tools, standards, and delivery process.",
        ],
    },
    {
        question: "Can I build technical teams across multiple Latin American countries simultaneously?",
        answers: [
            "Yes. You can source professionals from different supported countries and centralize the staffing relationship with <span style='font-weight: 800; color: #1b1b1b;'>Oberstaff</span><span style='color: #FF66CC; font-weight: 900;'>.</span> The recommended market depends on the stack, seniority, English level, schedule, compensation range, and availability.",
        ],
    },
    {
        question: "How long does it take to onboard a technical professional?",
        answers: [
            "Timing varies by role complexity, seniority, technical assessment requirements, English level, compensation, candidate availability, equipment needs, and the selected engagement scope. Oberstaff provides a realistic search and onboarding timeline after the role is calibrated.",
        ],
    },
    {
        question: "How should I compare <strong>IT staff augmentation companies</strong>?",
        answers: [
            "Compare providers by candidate quality, technical specialization, screening depth, country coverage, workday overlap, cost visibility, onboarding process, responsibility split, replacement support, billing controls, intellectual property terms, and account responsiveness. A strong provider should also explain clearly how its service differs from outsourced staffing, EOR, and project outsourcing.",
        ],
    }
];
