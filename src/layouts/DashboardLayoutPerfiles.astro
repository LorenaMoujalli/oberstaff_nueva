		>
		<!-- 1. Estilos del Chat de n8n
		<link href="https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css" rel="stylesheet" />
		-->
		<!-- ChatGPT / OpenAI Pixel -->
		<script is:inline>
			!(function (w, d, s, u) {
				if (w.oaiq) return;
				var q = function () {
					q.q.push(arguments);
				};
				q.q = [];
				w.oaiq = q;
