---
import Header from "../components/Header.astro";
import FooterPerfiles from "../components/FooterPerfiles.astro";
import VideoTestimonialModal from "../components/video/VideoTestimonialModal.astro";

interface FooterLink {
	text: string;
	href: string;
}

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	footerTitle?: string;
	footerLinks?: FooterLink[];
	ogTitle?: string;
	ogDescription?: string;
	ogUrl?: string;
	ogImage?: string;
}

const {
	title = "",
	description = "",
	keywords = "",
	footerTitle,
	footerLinks,
	ogTitle = title,
	ogDescription = description,
	ogUrl = Astro.url.href,
	ogImage = "Contratar-Talento.webp",
} = Astro.props;

const canonicalOgImage = ogImage
	? ogImage.startsWith("http")
		? ogImage
		: new URL(
				ogImage.startsWith("/") ? ogImage : `/${ogImage}`,
				Astro.url.origin,
			).href
	: new URL("/Contratar-Talento.webp", Astro.url.origin).href;
---

<!doctype html>
<html lang="es">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-MKTCXHCB");
		</script>
		<!-- End Google Tag Manager -->
		<!-- Metricool Tracker -->
		<script is:inline>function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"aa19d129e1a7ed760423ea9aa423af17"})});</script>
		<!-- Geo-Redirección: Loader Anti-Flash -->
		<style id="geo-loader-style" is:inline>
			html.geo-loading {
				overflow: hidden !important;
			}
			html.geo-loading body {
				visibility: hidden !important;
				opacity: 0 !important;
			}
			html.geo-loading::before {
				content: "";
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				background: #ffffff;
				z-index: 2147483646;
			}
			html.geo-loading::after {
				content: "";
				position: fixed;
				top: calc(50% - 18px);
				left: calc(50% - 18px);
				width: 36px;
				height: 36px;
				border: 3px solid #e5e7eb;
				border-top-color: #111827;
				border-radius: 50%;
				animation: geo-spin 0.7s linear infinite;
				z-index: 2147483647;
			}
			@keyframes geo-spin {
				to {
					transform: rotate(360deg);
				}
			}
		</style>
		<script is:inline>
			(function () {
				var ua = navigator.userAgent || "";
				var isBot = /bot|googlebot|crawler|spider|robot|crawling/i.test(
					ua,
				);
				if (!isBot && !sessionStorage.getItem("geo_country")) {
					document.documentElement.classList.add("geo-loading");
				}
			})();
		</script>

		<!-- Geo-Redirección Unificada -->
		<script is:inline>
			(function () {
				var loaderRemoved = false;

				function removeLoader() {
					if (loaderRemoved) return;

					loaderRemoved = true;

					document.documentElement.classList.remove("geo-loading");

					var st = document.getElementById("geo-loader-style");

					if (st) st.parentNode.removeChild(st);
				}
				setTimeout(removeLoader, 2000);

				var userAgent = navigator.userAgent || "";
				var isBot = /bot|googlebot|crawler|spider|robot|crawling/i.test(
					userAgent,
				);
				if (isBot) {
					removeLoader();
					return;
				}

				var path = window.location.pathname;
				var isPR = path === "/pr" || path.indexOf("/pr/") === 0;

				var SOUTH_AMERICA = [
					"AR",
					"BO",
					"BR",
					"CL",
					"CO",
					"EC",
					"FK",
					"GF",
					"GY",
					"PE",
					"PY",
					"SR",
					"UY",
					"VE",
				];
				var AMERICAS_OTHER = [
					"AG",
					"AI",
					"AN",
					"AW",
					"BB",
					"BL",
					"BM",
					"BQ",
					"BS",
					"BZ",
					"CA",
					"CR",
					"CU",
					"CW",
					"DM",
					"DO",
					"GD",
					"GL",
					"GP",
					"GT",
					"HN",
					"HT",
					"JM",
					"KN",
					"KY",
					"LC",
					"MF",
					"MQ",
					"MS",
					"MX",
					"NI",
					"PA",
					"PM",
					"PR",
					"SV",
					"SX",
					"TC",
					"TT",
					"US",
					"VC",
					"VG",
					"VI",
				];

				function handleCountry(country) {
					var isSA = SOUTH_AMERICA.indexOf(country) !== -1;
					var isAO = AMERICAS_OTHER.indexOf(country) !== -1;
					if (isSA) {
						if (path !== "/vacantes" && path !== "/vacantes/") {
							window.location.replace("/vacantes");
							return;
						}
					} else if (isAO) {
						var isVac =
							path === "/vacantes" ||
							path.indexOf("/vacantes") === 0;
						if (!isPR && !isVac) {
							window.location.replace(
								path === "/" ? "/pr/" : "/pr" + path,
							);
							return;
						}
					} else {
						if (isPR) {
							window.location.replace(
								path === "/pr" ? "/" : "/" + path.substring(4),
							);
							return;
						}
					}
					removeLoader();
				}

				var cached = sessionStorage.getItem("geo_country");
				if (cached) {
					handleCountry(cached);
					return;
				}

				var ctrl =
					typeof AbortController !== "undefined"
						? new AbortController()
						: null;
				var tid = setTimeout(function () {
					if (ctrl) ctrl.abort();
					removeLoader();
				}, 1500);

				fetch(
					"https://www.cloudflare.com/cdn-cgi/trace",
					ctrl ? { signal: ctrl.signal } : {},
				)
					.then(function (r) {
						return r.text();
					})
					.then(function (text) {
						clearTimeout(tid);
						var m = text.match(/loc=([A-Z]{2})/);
						if (m) {
							sessionStorage.setItem("geo_country", m[1]);
							handleCountry(m[1]);
						} else {
							removeLoader();
						}
					})
					.catch(function () {
						clearTimeout(tid);
						removeLoader();
					});
			})();
		</script>
		<!-- Fin Geo-Redirección -->

		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
