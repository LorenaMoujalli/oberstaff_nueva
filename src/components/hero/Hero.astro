---
import HeroContent from "./HeroContent.astro";
import HeroVisual from "./HeroVisual.astro";
import "../../styles/hero/Hero.css";

interface Props {
    title?: string;
    description?: string;
    socialProof?: string;
    buttonText?: string;
    buttonHref?: string;
    videoButtonText?: string;
    showPedro?: boolean;
    badge?: string;
    card1Name?: string;
    card1Role?: string;
    card1Location?: string;
    card1Image?: string;
    card1MapIcon?: string;
    card2Name?: string;
    card2Role?: string;
    card2Location?: string;
    card2Image?: string;
    card2MapIcon?: string;
    card3Name?: string;
    card3Role?: string;
    card3Location?: string;
    card3Image?: string;
    card3MapIcon?: string;
}

const props = Astro.props;
---

<section class="hero-oberstaff">
    <div class="hero-container">
        <HeroContent {...props} />
        <HeroVisual {...props} />
    </div>
</section>
