---

<footer class="oberstaff-footer">
    <div class="footer-container">
        <div class="footer-main-grid">
            <!-- Columna de Marca -->
            <div class="footer-col-brand">
                <div class="brand-logo-row">
                    <span class="brand-text"
                        >Oberstaff<span class="brand-dot">.</span></span
                    >
                </div>
                <p class="brand-description">
                    Hire remote talent in South America and save up to 70% on payroll.
                    <strong class="brand-oberstaff">Oberstaff<span class="brand-dot">.</span></strong> helps you hire top-tier full-time professionals in South America,
                    allowing you to save on personnel costs while improving your team's quality.
                </p>
            </div>

            <!-- Columna Servicios -->
            <div class="footer-col-links">
                <p class="footer-col-title">Services</p>
                <ul>
                    <li><a href="/us/services/employer-of-record">Employer of Record</a></li>
                    <li><a href="/us/services/outsourced-staffing">Outsourced Staffing</a></li>
                    <li><a href="/us/services/staff-augmentation">Staff Augmentation</a></li>
                    <li><a href="/us/services/contractor-of-record">Contractor of Record</a></li>
                        
                </ul>
            </div>

            <!-- Columna Empresa --> 
            <div class="footer-col-links">
                <p class="footer-col-title">Company</p>
                <ul>
                    <li><a href="/us/about-us">About Us</a></li>
                    <li><a href="/us/contact">Contact</a></li>
                    <li><a href="/us/oberstaff-privacy-and-cookie-policy">Privacy & Cookie Policy</a></li>
                </ul>
            </div>
        </div>

        <hr class="footer-line" />

        <div class="footer-bottom-bar">
            <div class="footer-bottom-left">
                <p>
                    © 2026 <strong>Oberstaff<span class="brand-dot">.</span></strong> All rights reserved.
                </p>
            </div>
            <div class="footer-bottom-center">
                <p>
                    <a href="/us/oberstaff-privacy-and-cookie-policy" class="footer-privacy-link">Privacy & Cookie Policy</a>
                </p>
            </div>
            <div class="footer-bottom-right"></div>
        </div>
    </div>

    <style>
        .oberstaff-footer {
            background-color: #0d0d0d;
            color: #ffffff;
            padding: 80px 20px 40px 20px;
            width: 100%;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-main-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 60px;
            margin-bottom: 60px;
        }

        /* Columna de Marca */
        .brand-text {
            font-family: "Montserrat", sans-serif;
            font-size: 28px;
            font-weight: 700;
            font-style: normal;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .brand-dot {
            color: #ff66cc !important;
        }

        .brand-oberstaff {
            font-family: "Montserrat", sans-serif;
            font-weight: 700;
        }

        .brand-description {
            font-family: "Poppins", sans-serif;
            color: #a0a0a0;
            font-size: 15px;
            line-height: 1.6;
            margin-top: 20px;
            margin-bottom: 25px;
            max-width: 350px;
            text-align: justify;
        }

        .brand-contact-info p {
            font-family: "Poppins", sans-serif;
            color: #A0A0A0;
            font-size: 14px;
            font-weight: 600;
        }

        .footer-phone-link {
            color: #66ff99;
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .footer-phone-link:hover {
            opacity: 0.8;
            text-decoration: none;
        }

        /* Columnas de Enlaces */
        .footer-col-links h3,
        .footer-col-links .footer-col-title {
            font-family: "Montserrat", sans-serif !important;
            font-size: 16px !important;
            font-weight: 700 !important;
            font-style: normal !important;
            margin: 0 0 25px 0 !important;
            color: #ffffff !important;
            display: block !important;
        }

        .footer-col-links ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-col-links li {
            font-family: "Poppins", sans-serif;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .footer-col-links a {
            font-family: "Poppins", sans-serif;
            color: #a0a0a0;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

        .footer-col-links a:hover {
            color: #ff66cc;
        }

        /* Separador */
        .footer-line {
            border: 0;
            border-top: 1px solid #222;
            margin-bottom: 30px;
        }

        /* Barra inferior */
        .footer-bottom-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            color: #7a7a7a;
            font-family: "Poppins", sans-serif;
            font-size: 13px;
        }

        .footer-bottom-bar p {
            margin: 0;
        }

        .footer-bottom-left {
            text-align: left;
        }

        .footer-bottom-center {
            text-align: center;
        }

        .footer-bottom-right {
            text-align: right;
        }

        .footer-privacy-link {
            color: #a0a0a0;
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-privacy-link:hover {
            color: #ff66cc;
        }

        .footer-bottom-bar strong {
            color: #999;
        }

        /* Adaptive */
        @media (max-width: 900px) {
            .footer-main-grid {
                grid-template-columns: 1fr;
                gap: 40px;
                text-align: center;
            }
            .brand-description {
                margin: 20px auto;
            }
            .footer-bottom-bar {
                grid-template-columns: 1fr;
                gap: 12px;
                text-align: center;
            }
            .footer-bottom-left,
            .footer-bottom-center,
            .footer-bottom-right {
                text-align: center;
            }
            .footer-bottom-right {
                display: none;
            }
        }
    </style>
</footer>
