---
import "../../styles/hero-contacto/HeroContactoSection.css";
import HeroBackground from "./HeroBackground.astro";
import HeroContent from "./HeroContent.astro";
import HeroButtons from "./HeroButtons.astro";
import HeroStats from "./HeroStats.astro";

interface Props {
    kicker?: string;
    title?: string;
    subtitle?: string;
    features?: string;
    primaryText?: string;
    primaryHref?: string;
    secondaryText?: string;
    secondaryHref?: string;
    whatsappNumber?: string;
    showSecondaryButton?: boolean;
    stats?: any[];
    stat1Number?: string;
    stat1Description?: string;
    stat1ColorClass?: string;
    stat2Number?: string;
    stat2Description?: string;
    stat2ColorClass?: string;
    stat3Number?: string;
    stat3Description?: string;
    stat3ColorClass?: string;
}

const {
    kicker,
    title,
    subtitle,
    features,
    primaryText,
    primaryHref,
    secondaryText,
    secondaryHref,
    whatsappNumber,
    showSecondaryButton = true,
    stats,
    stat1Number,
    stat1Description,
    stat1ColorClass,
    stat2Number,
    stat2Description,
    stat2ColorClass,
    stat3Number,
    stat3Description,
    stat3ColorClass
} = Astro.props;

const finalSecondaryHref = whatsappNumber
    ? `https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}`
    : secondaryHref;
---

<section class="hero-cro-section">
    <HeroBackground />

    <div class="hero-container">
        <HeroContent 
            kicker={kicker}
            title={title}
            subtitle={subtitle}
            features={features}
        />

        <HeroButtons 
            primaryText={primaryText}
            primaryHref={primaryHref}
            secondaryText={secondaryText}
            secondaryHref={finalSecondaryHref}
            showSecondaryButton={showSecondaryButton}
        />
        
        <HeroStats 
            stats={stats} 
            stat1Number={stat1Number}
            stat1Description={stat1Description}
            stat1ColorClass={stat1ColorClass}
            stat2Number={stat2Number}
            stat2Description={stat2Description}
            stat2ColorClass={stat2ColorClass}
            stat3Number={stat3Number}
            stat3Description={stat3Description}
            stat3ColorClass={stat3ColorClass}
        />
    </div>
</section>
