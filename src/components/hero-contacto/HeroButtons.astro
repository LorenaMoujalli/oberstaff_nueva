---
import "../../styles/hero-contacto/HeroButtons.css";

interface Props {
    primaryText?: string;
    primaryHref?: string;
    secondaryText?: string;
    secondaryHref?: string;
    showSecondaryButton?: boolean;
}

const {
    primaryText = "Solicitar llamada gratuita →",
    primaryHref = "https://info-oberstaff.zohobookings.com/4327750000001590002/#/4327750000001590002",
    secondaryText = "📱 Escribir por WhatsApp",
    secondaryHref = "https://wa.me/34930289966",
    showSecondaryButton = true,
} = Astro.props;
---

<!--https://wa.me/your-number -->
<div class="hero-buttons">
    <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="btn-hero btn-pink">{primaryText}</a>
    {showSecondaryButton && (
        <a href={secondaryHref} target="_blank" rel="noopener noreferrer" class="btn-hero btn-outline"
            >{secondaryText}</a
        >
    )}
</div>
