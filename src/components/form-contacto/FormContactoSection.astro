---
import "../../styles/form-contacto/FormContactoSection.css";
import ContactFormCard from "./ContactFormCard.astro";
import ContactInfoColumn from "./ContactInfoColumn.astro";

interface Props {
    id?: string;
    formTitle?: string;
    formDescription?: string;
    formButtonText?: string;
    formMicrocopy?: string;
    stepsTitle?: string;
    steps?: any[];
    reviewTitle?: string;
    reviewItems?: any[];
    webhookUrl?: string;
    formName?: string;
    pais?: string;

    // ContactFormCard layout & visibility
    showRolesField?: boolean;
    showCommentsField?: boolean;
    phoneBelowEmail?: boolean;

    // ContactFormCard text props
    namePlaceholder?: string;
    companyPlaceholder?: string;
    emailPlaceholder?: string;
    phonePlaceholder?: string;
    rolesPlaceholder?: string;
    commentsPlaceholder?: string;

    consentText?: string;
    privacyPolicyText?: string;
    privacyPolicyUrl?: string;
    consentErrorText?: string;

    captchaLabel?: string;
    captchaHint?: string;
    captchaPlaceholder?: string;
    captchaRefreshTitle?: string;
    captchaRequiredError?: string;
    captchaInvalidError?: string;

    buttonLoadingText?: string;
    successToastMessage?: string;
    duplicateToastMessage?: string;
    errorFeedbackMessage?: string;
}

const {
    id = "formulario",
    formTitle,
    formDescription,
    formButtonText,
    formMicrocopy,
    stepsTitle,
    steps,
    reviewTitle,
    reviewItems,
    webhookUrl = "",
    formName = "",
    pais = "",

    showRolesField = true,
    showCommentsField = true,
    phoneBelowEmail = false,

    namePlaceholder,
    companyPlaceholder,
    emailPlaceholder,
    phonePlaceholder,
    rolesPlaceholder,
    commentsPlaceholder,
    consentText,
    privacyPolicyText,
    privacyPolicyUrl,
    consentErrorText,
    captchaLabel,
    captchaHint,
    captchaPlaceholder,
    captchaRefreshTitle,
    captchaRequiredError,
    captchaInvalidError,
    buttonLoadingText,
    successToastMessage,
    duplicateToastMessage,
    errorFeedbackMessage
} = Astro.props;
---

<section class="form-section" id={id}>
    <div class="form-container">
        <ContactFormCard 
            title={formTitle}
            description={formDescription}
            buttonText={formButtonText}
            microcopy={formMicrocopy}
            webhookUrl={webhookUrl}
            formName={formName}
            pais={pais}
            showRolesField={showRolesField}
            showCommentsField={showCommentsField}
            phoneBelowEmail={phoneBelowEmail}
            namePlaceholder={namePlaceholder}
            companyPlaceholder={companyPlaceholder}
            emailPlaceholder={emailPlaceholder}
            phonePlaceholder={phonePlaceholder}
            rolesPlaceholder={rolesPlaceholder}
            commentsPlaceholder={commentsPlaceholder}
            consentText={consentText}
            privacyPolicyText={privacyPolicyText}
            privacyPolicyUrl={privacyPolicyUrl}
            consentErrorText={consentErrorText}
            captchaLabel={captchaLabel}
            captchaHint={captchaHint}
            captchaPlaceholder={captchaPlaceholder}
            captchaRefreshTitle={captchaRefreshTitle}
            captchaRequiredError={captchaRequiredError}
            captchaInvalidError={captchaInvalidError}
            buttonLoadingText={buttonLoadingText}
            successToastMessage={successToastMessage}
            duplicateToastMessage={duplicateToastMessage}
            errorFeedbackMessage={errorFeedbackMessage}
        />

        <ContactInfoColumn 
            stepsTitle={stepsTitle}
            steps={steps}
            reviewTitle={reviewTitle}
            reviewItems={reviewItems}
        />
    </div>
</section>
