---
import "../../styles/form-contacto/ContactFormCard.css";

interface Props {
    title?: string;
    description?: string;
    buttonText?: string;
    microcopy?: string;
    webhookUrl?: string;
    formName?: string;
    pais?: string;

    // Field Visibility and Layout
    showRolesField?: boolean;
    showCommentsField?: boolean;
    phoneBelowEmail?: boolean;

    // Field Placeholders
    namePlaceholder?: string;
    companyPlaceholder?: string;
    emailPlaceholder?: string;
    phonePlaceholder?: string;
    rolesPlaceholder?: string;
    commentsPlaceholder?: string;

    // SMS Consent / Policy
    consentText?: string;
    privacyPolicyText?: string;
    privacyPolicyUrl?: string;
    consentErrorText?: string;

    // Captcha Texts
    captchaLabel?: string;
    captchaHint?: string;
    captchaPlaceholder?: string;
    captchaRefreshTitle?: string;
    captchaRequiredError?: string;
    captchaInvalidError?: string;

    // Dynamic Feedback / Status
    buttonLoadingText?: string;
    successToastMessage?: string;
    duplicateToastMessage?: string;
    errorFeedbackMessage?: string;
}

const {
    title = "Cuéntanos qué necesita tu empresa",
    description = "Completa el formulario y un especialista de <strong style=\"font-weight: 800;\"><span style=\"color: #1B1B1B;\">Oberstaff</span><span style=\"color: #FF66CC;\">.</span></strong> te orientará sobre la estructura más conveniente. No necesitas tener todo definido: podemos ayudarte a aclarar el perfil, el nivel de seniority, el modelo y los próximos pasos.",
    buttonText = "Solicitar llamada gratuita →",
    microcopy = "↳ Sin compromiso · te contactaremos en menos de 24 horas para entender tu necesidad y explicarte los siguientes pasos.",
    webhookUrl = "",
    formName = "",
    pais = "",

    showRolesField = true,
    showCommentsField = true,
    phoneBelowEmail = false,

    namePlaceholder = "Nombre completo *",
    companyPlaceholder = "Nombre de la empresa *",
    emailPlaceholder = "Email corporativo *",
    phonePlaceholder = "Teléfono *",
    rolesPlaceholder = "¿Cuántos profesionales o qué roles buscas contratar? *",
    commentsPlaceholder = "Comentarios adicionales (opcional)",

    consentText = '<strong>Al facilitar su número de teléfono</strong>, aceptas recibir mensajes SMS relacionados con atención al cliente de <strong>Oberstaff<span style="color: #FF66CC;">.</span></strong> La frecuencia de los mensajes puede variar. Pueden aplicarse tarifas estándar de mensajes y datos. Responde STOP para cancelar la suscripción. Responde Help para obtener ayuda.',
    privacyPolicyText = "Política de privacidad y uso de cookies.",
    privacyPolicyUrl,
    consentErrorText = "⚠ Debes aceptar el consentimiento para continuar.",

    captchaLabel = "Código de verificación ",
    captchaHint = "Ingresa el texto que ves en la imagen",
    captchaPlaceholder = "Escribe el código",
    captchaRefreshTitle = "Nuevo código",
    captchaRequiredError = "⚠ Este campo es obligatorio. Ingresa el código de la imagen.",
    captchaInvalidError = "❌ El código ingresado es incorrecto. Se generó un nuevo código, inténtalo de nuevo.",

    buttonLoadingText = "Enviando...",
    successToastMessage = "¡Mensaje enviado con éxito! Nos pondremos en contacto contigo pronto.",
    duplicateToastMessage = "Ya hemos recibido una solicitud con este correo. Nos pondremos en contacto pronto.",
    errorFeedbackMessage = "❌ Error al enviar. Por favor inténtalo de nuevo.",
} = Astro.props;
 
const isPrPage = Astro.url.pathname.startsWith('/pr/') || Astro.url.pathname === '/pr' || Astro.url.pathname.includes('/pr/');
const isUsPage = Astro.url.pathname.includes('/us') || pais.toLowerCase().includes('estados unidos');
const finalPais = pais || (isPrPage ? "Puerto Rico" : (isUsPage ? "Estados Unidos" : "España"));
const finalPrivacyPolicyUrl = privacyPolicyUrl || (
  isPrPage 
    ? "/pr/politica-de-privacidad-y-cookies-de-oberstaff" 
    : (isUsPage
        ? "/us/oberstaff-privacy-and-cookie-policy"
        : "/politica-de-privacidad-y-cookies-de-oberstaff")
);
---

<!-- intl-tel-input library -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/css/intlTelInput.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/js/intlTelInput.min.js"></script>

<div class="form-card">
    <h2 set:html={title} />
    <p class="intro-text" set:html={description} />

    <form 
        class="modern-form" 
        data-webhook-url={webhookUrl} 
        data-is-pr={isPrPage ? "true" : "false"} 
        data-is-us={isUsPage ? "true" : "false"}
        data-form-name={formName} 
        data-pais={finalPais}
        data-loading-text={buttonLoadingText}
        data-consent-error={consentErrorText}
        data-captcha-required={captchaRequiredError}
        data-captcha-invalid={captchaInvalidError}
        data-success-toast={successToastMessage}
        data-duplicate-toast={duplicateToastMessage}
        data-error-feedback={errorFeedbackMessage}
    >
        <input type="text" placeholder={namePlaceholder} required />
        <input type="text" placeholder={companyPlaceholder} required />
        
        {phoneBelowEmail ? (
            <input type="email" placeholder={emailPlaceholder} required />
            <input type="tel" placeholder={phonePlaceholder} required style="width: 100%; box-sizing: border-box;" oninput="this.value = this.value.replace(/[^0-9 ]/g, '')" data-phone="true" />
        ) : (
            <div class="form-row">
                <input type="email" placeholder={emailPlaceholder} required />
                <input type="tel" placeholder={phonePlaceholder} required style="width: 100%; box-sizing: border-box;" oninput="this.value = this.value.replace(/[^0-9 ]/g, '')" data-phone="true" />
            </div>
        )}

        {showRolesField && (
            <input type="text" placeholder={rolesPlaceholder} required />
        )}
        {showCommentsField && (
            <textarea rows="4" placeholder={commentsPlaceholder}></textarea>
        )}

        <!-- SMS Consent Checkbox -->
        <div class="form-group full-width consent-group" style="margin-bottom: 15px;">
            <label class="consent-label" style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; text-align: left;">
                <input
                    type="checkbox"
                    id="sms-consent"
                    class="consent-checkbox"
                    required
                    style="flex-shrink: 0; width: 18px; height: 18px; margin-top: 3px; accent-color: #6663FD; cursor: pointer;"
                />
                <span class="consent-text" style="font-family: 'Poppins', sans-serif; font-size: 10px; line-height: 1.6; color: #4a4a4a;">
                    <span set:html={consentText} />
                    {" "}
                    <a href={finalPrivacyPolicyUrl} target="_blank" class="consent-link" style="color: #6663FD; text-decoration: underline;">{privacyPolicyText}</a>
                    <span class="required-star" style="color: #ef4444; font-weight: 700; margin-left: 2px;">*</span>
                </span>
            </label>
            <p class="consent-error" id="consent-error" aria-live="polite" style="font-size: 12px; color: #ef4444; margin-top: 4px; min-height: 1em; text-align: left;"></p>
        </div>

        <!-- CAPTCHA Verification -->
        <div class="form-group full-width captcha-group" style="margin-bottom: 20px; text-align: left;">
            <label class="captcha-label" style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 600; color: #1B1B1B; display: block; margin-bottom: 4px;">{captchaLabel}<span class="required-star" style="color: #ef4444; font-weight: 700; margin-left: 2px;">*</span></label>
            <p class="captcha-hint" style="font-family: 'Poppins', sans-serif; font-size: 12px; color: #888; margin: 0 0 8px 0;">{captchaHint}</p>
            <div class="captcha-input-row" style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
                <input
                    type="text"
                    id="captcha-input"
                    class="captcha-input"
                    placeholder={captchaPlaceholder}
                    autocomplete="off"
                    maxlength="8"
                    required
                    style="font-family: 'Poppins', sans-serif; background-color: #FAFAFC; border: 1px solid #E0E0E0; padding: 10px 14px; border-radius: 8px; font-size: 15px; outline: none; transition: border-color 0.3s ease, box-shadow 0.3s ease; width: 200px; color: #1B1B1B; letter-spacing: 2px;"
                />
                <button type="button" id="captcha-refresh" class="captcha-refresh-btn" title={captchaRefreshTitle} aria-label={captchaRefreshTitle} style="background: none; border: 1.5px solid #6663FD; border-radius: 6px; color: #6663FD; font-size: 18px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s, color 0.2s; padding: 0; flex-shrink: 0;">
                    &#x21bb;
                </button>
            </div>
            <canvas id="captcha-canvas" class="captcha-canvas" width="200" height="60" aria-label="Código de verificación visual" style="display: block; border-radius: 8px; border: 1px solid #ddd; background: #f4f4f8; user-select: none; pointer-events: none;"></canvas>
            <p class="captcha-error" id="captcha-error" aria-live="polite" style="font-size: 12px; color: #ef4444; margin-top: 4px; min-height: 1em;"></p>
        </div>

        <button type="submit" class="btn-submit">{buttonText}</button>
        <p class="form-feedback" aria-live="polite"></p>
    </form>

    <p class="microcopy-footer" set:html={microcopy} />
</div>

<style>
    .form-feedback {
        text-align: center;

        font-size: 0.9rem;
        font-weight: 500;
        min-height: 1.2em;
    }
    .form-feedback.success {
        color: #22c55e;
    }
    .form-feedback.error {
        color: #ef4444;
    }
    .captcha-input.invalid {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12) !important;
    }
    .captcha-refresh-btn:hover {
        background: #6663FD !important;
        color: #fff !important;
    }
    :global(.modern-form .iti) {
        width: 100%;
    }
</style>

<style is:global>
    /* ── Toast Notification ── */
    .form-toast {
        position: fixed;
        bottom: 32px;
        right: 32px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 500;
        max-width: 420px;
        min-width: 280px;
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.35s ease, transform 0.35s ease;
        pointer-events: auto;
    }
    .form-toast--visible {
        opacity: 1;
        transform: translateY(0);
    }
    .form-toast--success {
        background: #ffffff;
        border-left: 5px solid #22c55e;
        color: #1b1b1b;
    }
    .form-toast--error {
        background: #ffffff;
        border-left: 5px solid #ef4444;
        color: #1b1b1b;
    }
    .toast-icon {
        font-size: 20px;
        flex-shrink: 0;
    }
    .toast-msg {
        flex: 1;
        line-height: 1.5;
    }
    .toast-close {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        color: #999;
        padding: 0 2px;
        line-height: 1;
        flex-shrink: 0;
        transition: color 0.2s;
    }
    .toast-close:hover {
        color: #333;
    }
    @media (max-width: 480px) {
        .form-toast {
            bottom: 16px;
            right: 12px;
            left: 12px;
            max-width: 100%;
            min-width: unset;
        }
    }
</style>

<script>
    // ── Toast Notification ─────────────────────────────────────────
    function showToast(message: string, type: 'success' | 'error' = 'success') {
        const existing = document.getElementById('form-toast');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.id = 'form-toast';
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.innerHTML = `<span class="toast-icon">${type === 'success' ? '✅' : '❌'}</span><span class="toast-msg">${message}</span><button class="toast-close" aria-label="Cerrar">✕</button>`;
        toast.className = `form-toast form-toast--${type}`;
        document.body.appendChild(toast);

        // Force reflow for animation
        void toast.offsetHeight;
        toast.classList.add('form-toast--visible');

        const dismiss = () => {
            toast.classList.remove('form-toast--visible');
            setTimeout(() => toast.remove(), 400);
        };
        toast.querySelector('.toast-close')?.addEventListener('click', dismiss);
        setTimeout(dismiss, 6000);
    }

    // ── CAPTCHA Generator ──────────────────────────────────────────
    const CAPTCHA_CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

    function generateCaptchaCode(length = 6): string {
        let code = '';
        for (let i = 0; i < length; i++) {
            code += CAPTCHA_CHARS[Math.floor(Math.random() * CAPTCHA_CHARS.length)];
        }
        return code;
    }

    function drawCaptcha(canvas: HTMLCanvasElement, code: string) {
        const ctx = canvas.getContext('2d')!;
        const w = canvas.width;
        const h = canvas.height;

        // Background
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#f0f0f6';
        ctx.fillRect(0, 0, w, h);

        // Noise lines
        for (let i = 0; i < 6; i++) {
            ctx.strokeStyle = `hsl(${Math.random() * 360}, 40%, 70%)`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(Math.random() * w, Math.random() * h);
            ctx.lineTo(Math.random() * w, Math.random() * h);
            ctx.stroke();
        }

        // Noise dots
        for (let i = 0; i < 40; i++) {
            ctx.fillStyle = `hsl(${Math.random() * 360}, 40%, 65%)`;
            ctx.beginPath();
            ctx.arc(Math.random() * w, Math.random() * h, 1, 0, Math.PI * 2);
            ctx.fill();
        }

        // Draw characters
        const charW = w / (code.length + 1);
        for (let i = 0; i < code.length; i++) {
            ctx.save();
            const x = charW * (i + 0.9);
            const y = h / 2 + 8;
            const angle = (Math.random() - 0.5) * 0.4;
            ctx.translate(x, y);
            ctx.rotate(angle);
            ctx.font = `bold ${20 + Math.random() * 6}px monospace`;
            ctx.fillStyle = `hsl(${240 + Math.random() * 60}, 55%, 35%)`;
            ctx.strokeStyle = `hsl(${240 + Math.random() * 60}, 40%, 60%)`;
            ctx.lineWidth = 0.5;
            ctx.strokeText(code[i], 0, 0);
            ctx.fillText(code[i], 0, 0);
            ctx.restore();
        }
    }

    document.querySelectorAll('form[data-webhook-url]').forEach((form) => {
        const f = form as HTMLFormElement;
        const webhookUrl = f.dataset.webhookUrl;
        if (!webhookUrl) return;

        // Skip if this form is not ContactFormCard (it might be initialized elsewhere)
        if (!f.classList.contains('modern-form')) return;

        if (f.dataset.listenerAdded) return;
        f.dataset.listenerAdded = 'true';

        const phoneInput = f.querySelector('input[data-phone="true"]') as HTMLInputElement;
        let iti: any = null;
        if (phoneInput && (window as any).intlTelInput) {
            const isPr = f.dataset.isPr === 'true';
            const isUs = f.dataset.isUs === 'true' || f.dataset.pais?.toLowerCase().includes('estados unidos');
            iti = (window as any).intlTelInput(phoneInput, {
                initialCountry: isUs ? "us" : (isPr ? "pr" : "es"),
                separateDialCode: true,
                preferredCountries: isUs
                    ? ["us", "pr", "co", "ar", "mx", "cl", "pe", "ve"]
                    : (isPr
                        ? ["pr", "co", "ar", "mx", "cl", "pe", "ve"]
                        : ["es", "co", "ar", "mx", "cl", "pe", "ve"]),
                utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/js/utils.js",
            });
        }

        // Dynamic text messages from data attributes
        const loadingText = f.dataset.loadingText || 'Enviando...';
        const consentErrorMsg = f.dataset.consentError || '⚠ Debes aceptar el consentimiento para continuar.';
        const captchaRequiredMsg = f.dataset.captchaRequired || '⚠ Este campo es obligatorio. Ingresa el código de la imagen.';
        const captchaInvalidMsg = f.dataset.captchaInvalid || '❌ El código ingresado es incorrecto. Se generó un nuevo código, inténtalo de nuevo.';
        const successToastMsg = f.dataset.successToast || '¡Mensaje enviado con éxito! Nos pondremos en contacto contigo pronto.';
        const duplicateToastMsg = f.dataset.duplicateToast || 'Ya hemos recibido una solicitud con este correo. Nos pondremos en contacto pronto.';
        const errorFeedbackMsg = f.dataset.errorFeedback || '❌ Error al enviar. Por favor inténtalo de nuevo.';

        // CAPTCHA state
        let currentCode = '';
        const canvas = f.querySelector('#captcha-canvas') as HTMLCanvasElement;
        const captchaInput = f.querySelector('#captcha-input') as HTMLInputElement;
        const captchaRefresh = f.querySelector('#captcha-refresh') as HTMLButtonElement;
        const captchaError = f.querySelector('#captcha-error') as HTMLElement;

        function refreshCaptcha() {
            currentCode = generateCaptchaCode();
            drawCaptcha(canvas, currentCode);
            captchaInput.value = '';
            captchaInput.classList.remove('invalid');
            if (captchaError) captchaError.textContent = '';
        }

        refreshCaptcha();
        captchaRefresh?.addEventListener('click', refreshCaptcha);

        // Consent elements
        const consentCheckbox = f.querySelector('#sms-consent') as HTMLInputElement;
        const consentError = f.querySelector('#consent-error') as HTMLElement;

        // Save original button text
        const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (btn) btn.dataset.originalHtml = btn.innerHTML ?? '';

        f.addEventListener('submit', async (e) => {
            e.preventDefault();
            const feedback = f.querySelector('.form-feedback') as HTMLElement;

            // ── Validate consent ──
            let hasError = false;
            if (!consentCheckbox?.checked) {
                if (consentError) consentError.textContent = consentErrorMsg;
                hasError = true;
            } else {
                if (consentError) consentError.textContent = '';
            }

            // ── Validate CAPTCHA ──
            const userCode = captchaInput?.value.trim().toUpperCase();
            if (!userCode) {
                if (captchaError) captchaError.textContent = captchaRequiredMsg;
                captchaInput?.classList.add('invalid');
                hasError = true;
            } else if (userCode !== currentCode) {
                refreshCaptcha();
                if (captchaError) captchaError.textContent = captchaInvalidMsg;
                captchaInput?.classList.add('invalid');
                hasError = true;
            } else {
                if (captchaError) captchaError.textContent = '';
                captchaInput?.classList.remove('invalid');
            }

             // ── Validate required fields ──
            const requiredFields = f.querySelectorAll('[required]');
            requiredFields.forEach((el) => {
                const input = el as HTMLInputElement | HTMLSelectElement;
                if (input.type !== 'checkbox') {
                    if (!input.value || !input.value.trim()) {
                        hasError = true;
                        input.classList.add('invalid');
                    } else {
                        input.classList.remove('invalid');
                    }
                }
            });

            if (hasError) return;

            // ── Collect data ──
            const inputs = f.querySelectorAll('input:not([type="checkbox"]):not(#captcha-input), textarea');
            const data: Record<string, string> = {};
            const formName = f.dataset.formName || "";
            inputs.forEach((el) => {
                const input = el as HTMLInputElement | HTMLTextAreaElement;
                const placeholder = input.getAttribute('placeholder') || '';
                const key = placeholder.replace(' *', '').trim() || input.type;
                const isPhone = input.type === 'tel' || input.dataset.phone === 'true';
                if (key) {
                    if (isPhone && iti) {
                        data[key] = iti.getNumber();
                    } else {
                        data[key] = input.value;
                    }
                }
            });
            data['Consentimiento SMS'] = 'Aceptado';
            const pais = f.dataset.pais || "";
            if (formName) {
                data['Origen Formulario'] = formName;
            }
            if (pais) {
                data['Pais'] = pais;
            }

            const emailInput = f.querySelector('input[type="email"]') as HTMLInputElement;
            const correo = emailInput ? emailInput.value.trim() : '';

            // Verificar si el correo ya existe
            if (correo) {
                btn.disabled = true;
                btn.innerHTML = loadingText;
                try {
                    const checkRes = await fetch('/api/check-email', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: correo })
                    });
                    if (checkRes.ok) {
                        const checkData = await checkRes.json();
                        if (checkData.exists) {
                            showToast(duplicateToastMsg, 'success');
                            (e.target as HTMLFormElement).reset();
                            btn.disabled = false;
                            btn.innerHTML = btn.dataset.originalHtml ?? 'Solicitar llamada gratuita →';
                            return;
                        }
                    }
                } catch (err) {
                    console.error("Error checking email duplicate:", err);
                }
                btn.disabled = false;
                btn.innerHTML = btn.dataset.originalHtml ?? 'Solicitar llamada gratuita →';
            }

            btn.disabled = true;
            btn.innerHTML = loadingText;
            if (feedback) {
                feedback.className = 'form-feedback';
                feedback.textContent = '';
            }

            try {
                // 1. Envío al webhook original (sin alterar)
                fetch(webhookUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                    mode: 'no-cors'
                }).catch(err => console.error('Error al enviar webhook:', err));

                // 2. Envío a la base de datos local
                fetch('/api/guardar-lead', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        formId: f.id || 'contact-form-card',
                        formName: formName || undefined,
                        pais: pais || undefined,
                        webhookUrl: webhookUrl,
                        data: data
                    })
                }).catch(err => console.error('Error al guardar en base de datos:', err));

                // 3. Disparar evento de conversión Pixel de ChatGPT (OpenAI)
                if (typeof (window as any).oaiq === 'function') {
                    (window as any).oaiq("measure", "registration_completed", {
                        type: "customer_action"
                    });
                }

                f.reset();
                refreshCaptcha();
                showToast(successToastMsg, 'success');
            } catch {
                if (feedback) {
                    feedback.className = 'form-feedback error';
                    feedback.textContent = errorFeedbackMsg;
                }
            } finally {
                btn.disabled = false;
                btn.innerHTML = btn.dataset.originalHtml ?? 'Solicitar llamada gratuita →';
            }
        });

        // Clear captcha error on input
        captchaInput?.addEventListener('input', () => {
            captchaInput.classList.remove('invalid');
            if (captchaError) captchaError.textContent = '';
        });

        // Clear consent error on check
        consentCheckbox?.addEventListener('change', () => {
            if (consentCheckbox.checked && consentError) consentError.textContent = '';
        });
    });
</script>
